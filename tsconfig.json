{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": false,
    "noImplicitThis": false,
    "strictNullChecks": true,
    "types": ["node"]
  },
  "include": [
    "types/**/*.d.ts",
    "static/js/utils.js",
    "static/js/api.js",
    "static/js/video.js",
    "static/js/auth.js",
    "static/js/feed.js",
    "static/js/state.js"
  ],
  "exclude": ["node_modules", "static/js/dist", "static/js/tests"]
}
