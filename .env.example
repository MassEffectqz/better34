# Скопируйте в .env и отредактируйте под себя.
# .env читается run.ps1 (при запуске) и Go-сервером при `go run .`:
# значения из .env НЕ перезаписывают уже заданные переменные окружения.

# Интерфейс сервера: 0.0.0.0 — доступ со всей LAN, 127.0.0.1 — только локально.
BRIEFLY_HOST = "0.0.0.0"

# Белый список хостов (пусто — автодетекция всех сетевых IP машины).
BRIEFLY_ALLOWED_HOSTS = ""

# HTTPS + HTTP/2 (self-signed сертификат генерируется в data/tls при первом запуске).
BRIEFLY_TLS = "1"

# HTTP/3/QUIC на том же порту (0 — выключить).
BRIEFLY_H3 = "1"

# Бюджет дискового media-cache в ГБ (общий для всех устройств LAN).
BRIEFLY_MEDIA_CACHE_GB = "20"

# Макс. размер скачиваемого файла в МБ (по умолчанию: картинки 4, видео 256).
# BRIEFLY_MAX_DOWNLOAD_MB = "1024"

# Семантический поиск (локальная Ollama).
BRIEFLY_OLLAMA = "http://127.0.0.1:11434"
BRIEFLY_OLLAMA_MODEL = "dolphin-mistral:7b"

# Уровень лога: debug | info | warn | error (по умолчанию info).
# BRIEFLY_LOG_LEVEL = "info"