{
  "name": "better34-frontend",
  "private": true,
  "type": "module",
  "description": "Инструменты фронтенда better34: lint, типо-проверка, тесты, бандл и единый quality gate",
  "scripts": {
    "lint": "eslint static/js",
    "typecheck": "tsc -p . && tsc -p tsconfig.tests.json && tsc -p tsconfig.typed-tests.json",
    "test": "node --test \"static/js/tests/*.test.js\"",
    "build": "esbuild static/js/app.js --bundle --minify --outfile=static/js/dist/app.js --format=esm && node scripts/precompress.mjs",
    "check:go": "node scripts/quality-gate.mjs",
    "check:race": "go test -race . ./internal/...",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run check:go",
    "check:ci": "npm run check && npm run check:race"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@types/node": "^26.6.2",
    "esbuild": "^0.25",
    "eslint": "^9",
    "typescript": "^5"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
