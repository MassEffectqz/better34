{
  "name": "better34-frontend",
  "private": true,
  "type": "module",
  "description": "Инструменты фронтенда better34: lint, типо-проверка, тесты, бандл и единый quality gate",
  "scripts": {
    "lint": "eslint static/js",
    "typecheck": "tsc -p . && tsc -p tsconfig.tests.json && tsc -p tsconfig.typed-tests.json",
    "test": "node --test \"static/js/tests/*.test.js\"",
    "build": "esbuild static/js/app.js --bundle --minify --outfile=static/js/dist/app.js --format=esm && node scripts/precompress.mjs",
    "check:go": "node scripts/quality-gate.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:mobile": "node scripts/check-mobile.mjs",
    "check:css": "node scripts/check-css-vars.mjs",
    "check:icons": "node scripts/check-icons.mjs",
    "check:embed": "node scripts/check-embed.mjs",
    "check:batch": "node scripts/check-batch.mjs",
    "check:race": "go test -race . ./internal/...",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run check:go && npm run check:i18n && npm run check:icons && npm run check:mobile && npm run check:css && npm run check:embed && npm run check:batch",
    "check:ci": "npm run check && npm run check:race"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/node": "^26.6.2",
    "esbuild": "^0.25",
    "eslint": "^10",
    "typescript": "^5"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
